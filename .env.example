# AgentPot environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase project URL and keys (Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password-only admin login kept for Agent Tester curl checks
# (email/password accounts use Supabase Auth and do not need this)
ADMIN_PASSWORD=change-this-secure-admin-password

# Shared key for POST /api/ingest (friendly agents reporting their own actions)
AGENT_INGEST_KEY=change-this-ingest-key

# Optional. Defaults to the current host if unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000
